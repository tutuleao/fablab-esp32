# ---------------------------------------------------------------------------
# Copie este arquivo para .env (uso local) ou cadastre as variáveis no painel
# da Vercel em Project > Settings > Environment Variables.
# ---------------------------------------------------------------------------

# Segredo usado para assinar o cookie de sessão.
# Gere um valor longo e aleatório, por exemplo com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=troque-por-um-segredo-bem-longo-e-aleatorio

# Projeto Supabase > Settings > API
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# ATENÇÃO: use a chave service_role SOMENTE no servidor.
# Nunca coloque esta chave em arquivos do front-end nem no navegador.
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role

# Fuso horário da escola.
# O nome TZ é reservado na Vercel; use APP_TIMEZONE.
# Se não for definido, o sistema usa America/Sao_Paulo.
APP_TIMEZONE=America/Sao_Paulo

# Token do dispositivo ESP32 (tela touch do Fab Lab).
# Deve ser igual à constante DEVICE_TOKEN do firmware.
# Sem esse valor, os endpoints /api/device/... respondem 503.
DEVICE_TOKEN=troque-por-um-token-longo-e-aleatorio
